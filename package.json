{
  "name": "dsh-codebuddy-link",
  "version": "0.3.16",
  "repository": {"type": "git", "url": "git+https://github.com/liubaicai/dsh-codebuddy-link.git"},
  "homepage": "https://github.com/liubaicai/dsh-codebuddy-link#readme",
  "bugs": {"url": "https://github.com/liubaicai/dsh-codebuddy-link/issues"},
  "description": "通过官方 CodeBuddy CLI 直接调用模型，无需逆向模型 API，与 WorkBuddy 共享账户积分。",
  "icon": "./assets/workbuddy.webp",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {".": {"types": "./dist/index.d.ts", "default": "./dist/index.js"}, "./client": "./dist/client.js", "./cordis.patch.yml": "./cordis.patch.yml", "./package.json": "./package.json", "./locale/*.json": "./locale/*.json", "./icon": "./assets/workbuddy.webp"},
  "files": ["dist", "scripts/verify-package.mjs", "assets", "locale", "cordis.patch.yml", "README.md", "LICENSE", "NOTICE", "CHANGELOG.md"],
  "keywords": ["dsh-plugin", "deepseek-harness", "codebuddy"],
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}, "client": {"inject": ["slots"], "platform": "web"}},
  "engines": {"node": ">=22.18.0"},
  "scripts": {"build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs", "check": "tsc --noEmit", "test": "npm run build && node --experimental-strip-types --test test/*.test.ts", "prepack": "node scripts/verify-package.mjs", "verify:package": "node scripts/verify-package.mjs"},
  "peerDependencies": {"@deepseek-ai/cordis": "^4.0.1", "@deepseek-ai/dsh-commands": ">=0.1.2-rc.1", "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1", "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1"},
  "devDependencies": {"@deepseek-ai/cordis": "^4.0.1", "@deepseek-ai/dsh-commands": "0.1.2-rc.1", "@deepseek-ai/dsh-llm": "0.1.2-rc.1", "@deepseek-ai/dsh-tools": "0.1.2-rc.1", "@types/node": "^22.0.0", "typescript": "^5.9.2"}
}
